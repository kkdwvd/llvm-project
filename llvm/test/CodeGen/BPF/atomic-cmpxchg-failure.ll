; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=bpfel -mcpu=v4 -verify-machineinstrs | FileCheck %s

; A cmpxchg is fully ordered when it succeeds, but a failed one reads
; unordered in the kernel's memory model, and on the arm64 JIT without LSE
; and the RISC-V JIT without Zacas. So one whose failure order is acquire or
; seq_cst takes a full barrier, a fetch-add of zero on the stack (fence.ll),
; on its failure path only.

define i1 @seq_cst(ptr %p, i64 %expected, i64 %desired) {
; CHECK-LABEL: seq_cst:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r0 = r2
; CHECK-NEXT:    r0 = cmpxchg_64(r1 + 0, r0, r3)
; CHECK-NEXT:    if r0 == r2 goto .LBB0_2
; CHECK-NEXT:  # %bb.1: # %cmpxchg.failure
; CHECK-NEXT:    *(u64 *)(r10 - 8) = 0
; CHECK-NEXT:    r1 = 0
; CHECK-NEXT:    r1 = atomic_fetch_add((u64 *)(r10 - 8), r1)
; CHECK-NEXT:  .LBB0_2: # %cmpxchg.end
; CHECK-NEXT:    w1 = 1
; CHECK-NEXT:    if r0 == r2 goto .LBB0_4
; CHECK-NEXT:  # %bb.3: # %cmpxchg.end
; CHECK-NEXT:    w1 = 0
; CHECK-NEXT:  .LBB0_4: # %cmpxchg.end
; CHECK-NEXT:    w0 = w1
; CHECK-NEXT:    exit
  %res = cmpxchg ptr %p, i64 %expected, i64 %desired seq_cst seq_cst, align 8
  %ok = extractvalue { i64, i1 } %res, 1
  ret i1 %ok
}

define i32 @acquire_i32(ptr %p, i32 %expected, i32 %desired) {
; CHECK-LABEL: acquire_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w0 = w2
; CHECK-NEXT:    w0 = cmpxchg32_32(r1 + 0, w0, w3)
; CHECK-NEXT:    if w0 == w2 goto .LBB1_2
; CHECK-NEXT:  # %bb.1: # %cmpxchg.failure
; CHECK-NEXT:    *(u64 *)(r10 - 8) = 0
; CHECK-NEXT:    r1 = 0
; CHECK-NEXT:    r1 = atomic_fetch_add((u64 *)(r10 - 8), r1)
; CHECK-NEXT:  .LBB1_2: # %cmpxchg.end
; CHECK-NEXT:    exit
  %res = cmpxchg ptr %p, i32 %expected, i32 %desired acquire acquire, align 4
  %old = extractvalue { i32, i1 } %res, 0
  ret i32 %old
}

; A relaxed failure needs nothing.
define i64 @relaxed_failure(ptr %p, i64 %expected, i64 %desired) {
; CHECK-LABEL: relaxed_failure:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r0 = r2
; CHECK-NEXT:    r0 = cmpxchg_64(r1 + 0, r0, r3)
; CHECK-NEXT:    exit
  %res = cmpxchg ptr %p, i64 %expected, i64 %desired acq_rel monotonic, align 8
  %old = extractvalue { i64, i1 } %res, 0
  ret i64 %old
}
