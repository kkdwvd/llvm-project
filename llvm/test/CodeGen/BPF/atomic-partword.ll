; CHECK-LABEL: cmpxchg_weak_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w5 = w1
; CHECK-NEXT:    w5 &= 3
; CHECK-NEXT:    w5 <<= 3
; CHECK-NEXT:    w4 = 255
; CHECK-NEXT:    w4 <<= w5
; CHECK-NEXT:    w4 ^= -1
; CHECK-NEXT:    r1 &= -4
; CHECK-NEXT:    w6 = *(u32 *)(r1 + 0)
; CHECK-NEXT:    w6 &= w4
; CHECK-NEXT:    w2 &= 255
; CHECK-NEXT:    w2 <<= w5
; CHECK-NEXT:    w3 &= 255
; CHECK-NEXT:    w3 <<= w5
; CHECK-NEXT:    w4 = w6
; CHECK-NEXT:    w4 |= w2
; CHECK-NEXT:    w6 |= w3
; CHECK-NEXT:    w0 = w4
; CHECK-NEXT:    w0 = cmpxchg32_32(r1 + 0, w0, w6)
; CHECK-NEXT:    w2 = 1
; CHECK-NEXT:    if w0 == w4 goto .LBB2_2
; CHECK-NEXT:  # %bb.1: # %partword.cmpxchg.loop
; CHECK-NEXT:    w2 = 0
; CHECK-NEXT:  .LBB2_2: # %partword.cmpxchg.end
; CHECK-NEXT:    w0 >>= w5
; CHECK-NEXT:    exit
  %res = cmpxchg weak ptr %p, i8 %cmp, i8 %new seq_cst seq_cst, align 1
  ret { i8, i1 } %res
}

