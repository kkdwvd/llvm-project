; 8- and 16-bit atomics work on the 32-bit word around them, with the 32-bit
; atomics of ALU32: and, or and xor as one fetching atomic on the word, the
; rest as a cmpxchg loop on it. Operations BPF has no instruction for, such
; as max, are a cmpxchg loop at any size. The IR side is in
; Transforms/AtomicExpand/BPF/partword.ll.

define i8 @or_i8(ptr %p, i8 %v) {
; CHECK-LABEL: or_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w0 = w2
; CHECK-NEXT:    w0 &= 255
; CHECK-NEXT:    w2 = w1
; CHECK-NEXT:    w2 &= 3
; CHECK-NEXT:    w2 <<= 3
; CHECK-NEXT:    w0 <<= w2
; CHECK-NEXT:    r1 &= -4
; CHECK-NEXT:    w0 = atomic_fetch_or((u32 *)(r1 + 0), w0)
; CHECK-NEXT:    w0 >>= w2
; CHECK-NEXT:    exit
  %old = atomicrmw or ptr %p, i8 %v seq_cst, align 1
  ret i8 %old
}

