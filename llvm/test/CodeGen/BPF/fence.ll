; BPF has no fence instruction, and its atomics that fetch are fully ordered.
; A fence is a fetch-add of zero on a stack slot of the function's own, the
; smp_mb() of the selftests' bpf_atomic.h, written first for the verifier,
; which refuses to read a stack slot never written; before ALU32, which a
; fetch-add needs, an exchange. Every fence of a function shares the one slot.
; Nothing orders less than a full barrier, so acquire and release fences are
; full barriers too; singlethread fences are compiler barriers
; (fence-singlethread.ll).

define void @fence_acquire() {
; V1-LABEL: fence_acquire:
; V1:       # %bb.0:
; V1-NEXT:    r1 = 0
; V1-NEXT:    *(u64 *)(r10 - 8) = r1
; V1-NEXT:    r1 = xchg_64(r10 - 8, r1)
; V1-NEXT:    exit
;
; V3-LABEL: fence_acquire:
; V3:       # %bb.0:
; V3-NEXT:    r1 = 0
; V3-NEXT:    *(u64 *)(r10 - 8) = r1
; V3-NEXT:    r1 = atomic_fetch_add((u64 *)(r10 - 8), r1)
; V3-NEXT:    exit
;
; V4-LABEL: fence_acquire:
; V4:       # %bb.0:
; V4-NEXT:    *(u64 *)(r10 - 8) = 0
; V4-NEXT:    r1 = 0
; V4-NEXT:    r1 = atomic_fetch_add((u64 *)(r10 - 8), r1)
; V4-NEXT:    exit
  fence acquire
  ret void
}

