; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=bpfel -mcpu=v4 -verify-machineinstrs | FileCheck %s

; Sequentially consistent loads and stores, std::atomic's default order: a
; seq_cst load is a load-acquire; a seq_cst store of 32 or 64 bits is an
; exchange, fully ordered; one of 8 or 16 bits, which has no exchange, is a
; store-release with a full barrier after it, a fetch-add of zero on the stack
; (fence.ll). This is the x86 and AArch64 mapping, and bpf_atomic.h's.

define i8 @load_i8(ptr %p) {
; CHECK-LABEL: load_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w0 = load_acquire((u8 *)(r1 + 0))
; CHECK-NEXT:    exit
  %v = load atomic i8, ptr %p seq_cst, align 1
  ret i8 %v
}

define i16 @load_i16(ptr %p) {
; CHECK-LABEL: load_i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w0 = load_acquire((u16 *)(r1 + 0))
; CHECK-NEXT:    exit
  %v = load atomic i16, ptr %p seq_cst, align 2
  ret i16 %v
}

define i32 @load_i32(ptr %p) {
; CHECK-LABEL: load_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w0 = load_acquire((u32 *)(r1 + 0))
; CHECK-NEXT:    exit
  %v = load atomic i32, ptr %p seq_cst, align 4
  ret i32 %v
}

define i64 @load_i64(ptr %p) {
; CHECK-LABEL: load_i64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r0 = load_acquire((u64 *)(r1 + 0))
; CHECK-NEXT:    exit
  %v = load atomic i64, ptr %p seq_cst, align 8
  ret i64 %v
}

define i64 @load_i8_sext(ptr %p) {
; CHECK-LABEL: load_i8_sext:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w1 = load_acquire((u8 *)(r1 + 0))
; CHECK-NEXT:    r0 = (s8)r1
; CHECK-NEXT:    exit
  %v = load atomic i8, ptr %p seq_cst, align 1
  %e = sext i8 %v to i64
  ret i64 %e
}

define void @store_i8(ptr %p, i8 %v) {
; CHECK-LABEL: store_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    store_release((u8 *)(r1 + 0), w2)
; CHECK-NEXT:    *(u64 *)(r10 - 8) = 0
; CHECK-NEXT:    r1 = 0
; CHECK-NEXT:    r1 = atomic_fetch_add((u64 *)(r10 - 8), r1)
; CHECK-NEXT:    exit
  store atomic i8 %v, ptr %p seq_cst, align 1
  ret void
}

define void @store_i16(ptr %p, i16 %v) {
; CHECK-LABEL: store_i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    store_release((u16 *)(r1 + 0), w2)
; CHECK-NEXT:    *(u64 *)(r10 - 8) = 0
; CHECK-NEXT:    r1 = 0
; CHECK-NEXT:    r1 = atomic_fetch_add((u64 *)(r10 - 8), r1)
; CHECK-NEXT:    exit
  store atomic i16 %v, ptr %p seq_cst, align 2
  ret void
}

define void @store_i32(ptr %p, i32 %v) {
; CHECK-LABEL: store_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w2 = xchg32_32(r1 + 0, w2)
; CHECK-NEXT:    exit
  store atomic i32 %v, ptr %p seq_cst, align 4
  ret void
}

define void @store_i64(ptr %p, i64 %v) {
; CHECK-LABEL: store_i64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r2 = xchg_64(r1 + 0, r2)
; CHECK-NEXT:    exit
  store atomic i64 %v, ptr %p seq_cst, align 8
  ret void
}

; Store buffering: the exchange keeps the load after the store.
define i64 @store_load(ptr %x, ptr %y) {
; CHECK-LABEL: store_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r3 = 1
; CHECK-NEXT:    r3 = xchg_64(r1 + 0, r3)
; CHECK-NEXT:    r0 = load_acquire((u64 *)(r2 + 0))
; CHECK-NEXT:    exit
  store atomic i64 1, ptr %x seq_cst, align 8
  %v = load atomic i64, ptr %y seq_cst, align 8
  ret i64 %v
}

; Read-modify-write atomics that fetch are fully ordered as they are.
define i64 @fetch_add(ptr %p, i64 %v) {
; CHECK-LABEL: fetch_add:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r0 = r2
; CHECK-NEXT:    r0 = atomic_fetch_add((u64 *)(r1 + 0), r0)
; CHECK-NEXT:    exit
  %old = atomicrmw add ptr %p, i64 %v seq_cst, align 8
  ret i64 %old
}
