; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=bpfel -mcpu=v4 -verify-machineinstrs | FileCheck %s

; An or whose operands have no bit set in common is an add, and the DAG turns
; an add into one when it can tell. A 64-bit one is selected as an add: the
; verifier tracks a pointer only through add and subtract, and a pointer is
; not told from a number here. A 32-bit one, which holds no pointer, and an or
; that may set a bit twice stay ors.

declare void @use(ptr)

; std::uint8_t bytes[8]; bytes[1 + (i & 3)] = 1: the frame index of the
; 8-aligned array plus an index below 8 has no bit in common with it.
define void @stack_index(i64 %i) {
; CHECK-LABEL: stack_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r1 &= 3
; CHECK-NEXT:    r2 = r10
; CHECK-NEXT:    r2 += -8
; CHECK-NEXT:    r1 += r2
; CHECK-NEXT:    *(u8 *)(r1 + 1) = 1
; CHECK-NEXT:    r1 = r2
; CHECK-NEXT:    call use
; CHECK-NEXT:    exit
  %bytes = alloca [8 x i8], align 8
  %low = and i64 %i, 3
  %idx = add i64 %low, 1
  %p = getelementptr inbounds i8, ptr %bytes, i64 %idx
  store i8 1, ptr %p, align 1
  call void @use(ptr %bytes)
  ret void
}

define i64 @disjoint_reg(i64 %x, i64 %y) {
; CHECK-LABEL: disjoint_reg:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r0 = r1
; CHECK-NEXT:    r2 &= 255
; CHECK-NEXT:    r0 <<= 8
; CHECK-NEXT:    r0 += r2
; CHECK-NEXT:    exit
  %hi = shl i64 %x, 8
  %lo = and i64 %y, 255
  %r = or disjoint i64 %hi, %lo
  ret i64 %r
}

define i64 @disjoint_imm(i64 %x) {
; CHECK-LABEL: disjoint_imm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r0 = r1
; CHECK-NEXT:    r0 <<= 8
; CHECK-NEXT:    r0 += 7
; CHECK-NEXT:    exit
  %hi = shl i64 %x, 8
  %r = or disjoint i64 %hi, 7
  ret i64 %r
}

; Known to have no bit in common without the flag.
define i64 @known_disjoint(i64 %x, i64 %y) {
; CHECK-LABEL: known_disjoint:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r0 = r1
; CHECK-NEXT:    r2 &= 255
; CHECK-NEXT:    r0 &= -256
; CHECK-NEXT:    r0 += r2
; CHECK-NEXT:    exit
  %hi = and i64 %x, -256
  %lo = and i64 %y, 255
  %r = or i64 %hi, %lo
  ret i64 %r
}

define i64 @not_disjoint(i64 %x, i64 %y) {
; CHECK-LABEL: not_disjoint:
; CHECK:       # %bb.0:
; CHECK-NEXT:    r0 = r1
; CHECK-NEXT:    r0 |= r2
; CHECK-NEXT:    exit
  %r = or i64 %x, %y
  ret i64 %r
}

define i32 @disjoint_i32(i32 %x, i32 %y) {
; CHECK-LABEL: disjoint_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    w0 = w1
; CHECK-NEXT:    w2 &= 255
; CHECK-NEXT:    w0 <<= 8
; CHECK-NEXT:    w0 |= w2
; CHECK-NEXT:    exit
  %hi = shl i32 %x, 8
  %lo = and i32 %y, 255
  %r = or disjoint i32 %hi, %lo
  ret i32 %r
}
