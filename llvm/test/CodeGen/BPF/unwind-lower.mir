# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=bpfel -mcpu=v4 -run-pass=bpf-unwind-lower -o - %s | FileCheck %s

# Outside an invoke, llvm.bpf.unwind.exit is unwind_exit, which returns the
# exception object in r0 as exit returns a value.

--- |
  define void @exit_void() uwtable {
    unreachable
  }

  define i128 @exit_pair() uwtable {
    unreachable
  }

  define void @exit_then_more() uwtable {
    unreachable
  }

  define void @exit_in_r0() uwtable {
    unreachable
  }
...
---
name:            exit_void
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: exit_void
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r0 = MOV_rr killed $r1
    ; CHECK-NEXT: UNWIND_EXIT implicit $r0
    UNWIND_EXIT_PSEUDO killed $r1
...
---
name:            exit_pair
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: exit_pair
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r0 = MOV_rr killed $r1
    ; CHECK-NEXT: $r2 = MOV_ri 0
    ; CHECK-NEXT: UNWIND_EXIT implicit $r0, implicit $r2
    UNWIND_EXIT_PSEUDO killed $r1
...
---
name:            exit_then_more
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: exit_then_more
  ; CHECK: bb.0:
  ; CHECK-NEXT:   liveins: $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = MOV_rr killed $r1
  ; CHECK-NEXT:   UNWIND_EXIT implicit $r0
  bb.0:
    successors: %bb.1
    liveins: $r1

    UNWIND_EXIT_PSEUDO killed $r1
    $r1 = MOV_ri 1
    JMP %bb.1

  bb.1:
    RET
...
---
name:            exit_in_r0
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: exit_in_r0
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: UNWIND_EXIT implicit $r0
    UNWIND_EXIT_PSEUDO killed $r0
...
